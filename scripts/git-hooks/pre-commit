#!/usr/bin/env bash
# Refuse staged text that CI would reject on house style.
#
# The commit-msg hook already judges the message. This judges what the commit
# CONTAINS: the writing rules in CLAUDE.md that a script can decide, applied to
# the lines being added rather than to the whole tree.
#
# Here rather than only in CI for the usual reason: while the text is still in
# the editor the fix is one keystroke, and after the push it is a second commit
# that says "fix style".
#
# INSTALL: git config core.hooksPath scripts/git-hooks
#
# SKIP, deliberately and rarely: SKIP_HOUSE_STYLE=1 git commit.
set -euo pipefail

if [ "${SKIP_HOUSE_STYLE:-0}" = "1" ]; then
  echo "pre-commit: house style skipped by SKIP_HOUSE_STYLE" >&2
  exit 0
fi

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
exec "$here/../check-house-style.sh" staged
