#!/usr/bin/env bash
# Refuse a push that CI would reject.
#
# WHY THIS EXISTS. Twice in one day a push went out that CI then failed on: once
# on lint, because the tests were run and the linter was not, and once on a test
# that only fails about one run in sixty-four. Both were caught by the runner
# minutes later, which is the expensive place to catch them - the branch is
# already public, somebody else may have pulled it, and the fix arrives as a
# second commit that says "fix CI".
#
# `just ci` is the same set the runner runs. Running it here costs a few minutes
# of local time and saves a red build plus a follow-up commit.
#
# INSTALL: git config core.hooksPath scripts/git-hooks
#
# SKIP, deliberately and rarely: SKIP_CI_HOOK=1 git push. Use it when you are
# pushing a branch you know is broken so somebody else can look at it - not to
# get past a failure you have not read.
set -euo pipefail

if [ "${SKIP_CI_HOOK:-0}" = "1" ]; then
  echo "pre-push: skipped by SKIP_CI_HOOK" >&2
  exit 0
fi

# Nothing to check when the push deletes a ref.
if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  exit 0
fi

echo "pre-push: running 'just ci' (SKIP_CI_HOOK=1 to bypass)" >&2
if ! command -v just >/dev/null 2>&1; then
  # No just on PATH is not a reason to push blind; nix has it.
  nix develop -c just ci
else
  just ci
fi
