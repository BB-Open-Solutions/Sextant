# Sextant secrets and local overrides (docker-compose env_file).
# Copy to .env and fill. In production use a secret manager
# (agenix on NixOS, Kubernetes Secrets).

# Postgres DSN for the observed plane and durable state.
SEXTANT_PG_DSN=

# OIDC client secret from your IdP (when auth is oidc).
SEXTANT_OIDC_CLIENT_SECRET=

# Session cookie encryption key: base64 of 32 random bytes.
#   head -c32 /dev/urandom | base64
SEXTANT_SESSION_KEY=

# Device check-in bearer token. Empty disables check-in.
SEXTANT_CHECKIN_TOKEN=

# JSON-API bearer token (dfctl, CI, integrations on /api/v1).
SEXTANT_API_TOKEN=
