{
  "openapi": "3.0.3",
  "info": {
    "title": "Sextant API",
    "version": "1.0.0-beta",
    "description": "Machine contract of the Sextant fleet control-plane. Additive-only after the 1.0 freeze. Authentication: Bearer token (personal or service) or browser session with X-CSRF-Token on mutations."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/api/v1/access": {
      "delete": {
        "summary": "Revoke a role binding",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "summary": "List role bindings",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Grant a role binding",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/assignments": {
      "delete": {
        "summary": "Unassign a policy",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Assign a policy to a scope",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/devices/{tag}": {
      "delete": {
        "summary": "Remove a device",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "summary": "Device with resolved configuration",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/filters/{id}": {
      "delete": {
        "summary": "Delete a filter",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "summary": "Create or replace a filter",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/policies/{id}": {
      "delete": {
        "summary": "Delete a policy",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "summary": "Create or replace a policy",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/rollout": {
      "delete": {
        "summary": "Cancel the active rollout",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "summary": "Rollout state and ring convergence",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Start a rollout (owner)",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/settings": {
      "delete": {
        "summary": "Clear a setting at a scope",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Set a setting at a scope",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/changes": {
      "get": {
        "summary": "List change requests",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Open a change request",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/changes/{id}": {
      "get": {
        "summary": "One change request",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/changes/{id}/diff": {
      "get": {
        "summary": "Unified diff the change would apply",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/devices": {
      "get": {
        "summary": "List devices",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Enroll a device",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/facts/{tag}": {
      "get": {
        "summary": "Hardware facts of one device",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/fleet": {
      "get": {
        "summary": "Full fleet document",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "summary": "Observed status of every device",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/status/{tag}": {
      "get": {
        "summary": "Observed status of one device",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/changes/{id}/abandon": {
      "post": {
        "summary": "Abandon a change",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/changes/{id}/edits": {
      "post": {
        "summary": "Apply a gated edit on the change branch",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/changes/{id}/merge": {
      "post": {
        "summary": "Merge a ready change (owner)",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/changes/{id}/submit": {
      "post": {
        "summary": "Run the build gate",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/groups": {
      "post": {
        "summary": "Create a group",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/rollout/tick": {
      "post": {
        "summary": "Advance the rollout engine one step",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/tokens": {
      "get": {
        "summary": "List your API tokens",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Mint an API token (secret shown once)",
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/v1/tokens/{id}": {
      "delete": {
        "summary": "Revoke an API token",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
