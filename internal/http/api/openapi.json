{
  "openapi": "3.0.3",
  "info": {
    "title": "Sextant API",
    "version": "1.0.0-beta",
    "description": "Machine contract of the Sextant fleet control-plane. Additive-only after the 1.0 freeze. Authentication: Bearer token (personal or service) or browser session with X-CSRF-Token on mutations."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/api/v1/access": {
      "delete": {
        "summary": "Revoke a role binding",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "summary": "List role bindings",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Grant a role binding",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/assignments": {
      "delete": {
        "summary": "Unassign a policy",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Assign a policy to a scope",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/devices/{tag}": {
      "delete": {
        "summary": "Remove a device",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "summary": "Device with resolved configuration",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "patch": {
        "summary": "Update device fields",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Patch hardware, class, assignedUser, groups, labels or itam. Editor at the device scope; new group memberships also need editor there."
      }
    },
    "/api/v1/filters/{id}": {
      "delete": {
        "summary": "Delete a filter",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "summary": "Create or replace a filter",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/policies/{id}": {
      "delete": {
        "summary": "Delete a policy",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "summary": "Create or replace a policy",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/rollout": {
      "delete": {
        "summary": "Cancel the active rollout",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "summary": "Rollout state and ring convergence",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Start a rollout (owner)",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/settings": {
      "delete": {
        "summary": "Clear a setting at a scope",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Set a setting at a scope",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/changes": {
      "get": {
        "summary": "List change requests",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Open a change request",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/changes/{id}": {
      "get": {
        "summary": "One change request",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/changes/{id}/diff": {
      "get": {
        "summary": "Unified diff the change would apply",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/devices": {
      "get": {
        "summary": "List devices",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Enroll a device",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/facts/{tag}": {
      "get": {
        "summary": "Hardware facts of one device",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/fleet": {
      "get": {
        "summary": "Full fleet document",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "summary": "Observed status of every device",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/status/{tag}": {
      "get": {
        "summary": "Observed status of one device",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/changes/{id}/abandon": {
      "post": {
        "summary": "Abandon a change",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/changes/{id}/edits": {
      "post": {
        "summary": "Apply a gated edit on the change branch",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/changes/{id}/merge": {
      "post": {
        "summary": "Merge a ready change (owner)",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/changes/{id}/submit": {
      "post": {
        "summary": "Run the build gate",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/groups": {
      "post": {
        "summary": "Create a group",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/rollout/tick": {
      "post": {
        "summary": "Advance the rollout engine one step",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/tokens": {
      "get": {
        "summary": "List your API tokens",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Mint an API token (secret shown once)",
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/v1/tokens/{id}": {
      "delete": {
        "summary": "Revoke an API token",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/devices/{tag}/retire": {
      "post": {
        "summary": "Retire a device",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Parks the device: the audit record stays, image builds, check-ins and rollout counting stop, and its credential is revoked. Editor at the device scope."
      }
    },
    "/api/v1/devices/{tag}/reactivate": {
      "post": {
        "summary": "Reactivate a retired device",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Returns the device to service and issues a fresh credential (shown once). Editor at the device scope."
      }
    },
    "/api/v1/groups/{name}": {
      "patch": {
        "summary": "Update a group",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Re-parent the group (cycle-safe) and/or change its IdP mapping. Org owner."
      },
      "delete": {
        "summary": "Remove a group",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Only an empty leaf group with no references (devices, subgroups, assignments, bindings, rings) can be removed. Org owner."
      }
    },
    "/api/v1/apps": {
      "put": {
        "summary": "Replace an app list at a scope",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Body: {scope, kind: packages|flatpaks|overlays, names}. Names pass the injection firewall; the gate validates the result. Editor at the scope."
      }
    },
    "/api/v1/rollout/plan": {
      "put": {
        "summary": "Replace the rollout ring plan",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Body: {plan} with rings [{group, soakMinutes, minHealthyPercent}]; null plan clears it. Org owner."
      }
    },
    "/api/v1/assurance": {
      "put": {
        "summary": "Configure audit controls",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Body: {requireFourEyes}. Org owner."
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Who am I",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Identity claims plus the effective role per visible scope, derived live from the current document. Feeds the profile menu."
      }
    },
    "/api/v1/me/preferences": {
      "get": {
        "summary": "My preferences",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Personal presentation settings (timezone, locale). Empty fields inherit the organisation default."
      },
      "put": {
        "summary": "Update my preferences",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Body: {timezone?, locale?}. Timezone must be an IANA name; locale one of the shipped UI languages."
      }
    },
    "/api/v1/audit": {
      "get": {
        "summary": "Configuration audit trail",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Newest commits on the config repo (?limit=, default 100). Org-wide viewer: commits span every scope."
      }
    },
    "/api/v1/devices/{tag}/credential": {
      "post": {
        "summary": "Re-issue a device credential",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Replaces the device credential (lost secret, re-image); the new secret is shown once. Editor at the device scope; refused for retired devices."
      }
    },
    "/api/v1/directory/groups": {
      "get": {
        "summary": "Browse IdP directory groups",
        "description": "Groups matching ?q= (substring) from the configured LDAP directory, for access-binding pickers. Requires owner at some scope; read-only.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/evidence": {
      "get": {
        "summary": "Audit evidence export",
        "description": "Self-contained JSON bundle for a period (?from=&to=, RFC 3339; default last 30 days): configuration commits, change requests with authorship, rollout promotions, and the controls in force. Org-wide viewer.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}