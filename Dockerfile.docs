# DAWO handbook image: build the mdBook, serve it static via nginx.
# Self-contained: mdBook bundles its own assets, no external CDN at runtime.

# Build stage: render the handbook with mdBook from nixpkgs (reproducible-ish,
# no US CDN - pulls from cache.nixos.org).
FROM docker.io/nixos/nix:latest AS build
WORKDIR /src
COPY docs/handbook ./docs/handbook
RUN nix --extra-experimental-features "nix-command flakes" \
      run nixpkgs#mdbook -- build docs/handbook

# Runtime stage: nginx serving the static book, non-root.
FROM docker.io/nginxinc/nginx-unprivileged:alpine
COPY --from=build /src/docs/handbook/book /usr/share/nginx/html
EXPOSE 8080
